{
  "name": "microservice-project",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "pnpm build:catalog && pnpm build:inventory",
    "build:catalog": "nest build catalog-service",
    "build:inventory": "nest build inventory-service",
    "format": "prettier --write \"apps/**/*.ts\" \"packages/**/*.ts\"",
    "start": "pnpm start:catalog",
    "start:catalog": "nest start catalog-service",
    "start:catalog:dev": "nest start catalog-service --watch",
    "start:catalog:debug": "nest start catalog-service --debug --watch",
    "start:catalog:prod": "node dist/apps/catalog-service/main",
    "start:inventory": "nest start inventory-service",
    "start:inventory:dev": "nest start inventory-service --watch",
    "start:inventory:debug": "nest start inventory-service --debug --watch",
    "start:inventory:prod": "node dist/apps/inventory-service/main",
    "lint": "eslint \"{apps,packages}/**/*.ts\" --fix",
    "typeorm": "node -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:catalog:run": "npm run typeorm -- migration:run -d apps/catalog-service/src/database/data-source.ts",
    "migration:catalog:generate": "npm run typeorm -- migration:generate apps/catalog-service/src/database/migrations/Catalog -d apps/catalog-service/src/database/data-source.ts",
    "migration:catalog:show": "typeorm-ts-node-commonjs migration:show -d apps/catalog-service/src/database/data-source.ts",
    "migration:catalog:revert": "typeorm-ts-node-commonjs migration:revert -d apps/catalog-service/src/database/data-source.ts",
    "migration:inventory:generate": "typeorm-ts-node-commonjs migration:generate apps/inventory-service/src/database/migrations/Inventory -d apps/inventory-service/src/database/data-source.ts",
    "migration:inventory:show": "typeorm-ts-node-commonjs migration:show -d apps/inventory-service/src/database/data-source.ts",
    "migration:inventory:run": "typeorm-ts-node-commonjs migration:run -d apps/inventory-service/src/database/data-source.ts",
    "migration:inventory:revert": "typeorm-ts-node-commonjs migration:revert -d apps/inventory-service/src/database/data-source.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/catalog-service/test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/typeorm": "^11.0.3",
    "nestjs-pino": "^4.6.1",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "coverageReporters": [
      "json",
      "lcov",
      "text"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/packages/",
      "<rootDir>/utils/"
    ],
    "moduleNameMapper": {
      "^@app/database$": "<rootDir>/packages/database/src",
      "^@app/database/(.*)$": "<rootDir>/packages/database/src/$1",
      "^@app/utils$": "<rootDir>/utils",
      "^@app/utils/(.*)$": "<rootDir>/utils/$1"
    }
  }
}
